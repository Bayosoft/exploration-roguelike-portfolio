<UserControl x:Class="ExplorationRoguelike.GUI.Card.CardView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Black">
        <TextBlock Text="{Binding Name}" FontSize="30" Foreground="White" Padding="10, 10, 10, 0"/>
        <TextBlock Text="{Binding Description}" FontSize="20" Foreground="White" Padding="10, 0, 10, 10" />
    </StackPanel>
</UserControl>