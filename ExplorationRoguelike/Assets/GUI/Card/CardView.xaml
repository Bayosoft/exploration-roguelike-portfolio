<UserControl x:Class="ExplorationRoguelike.GUI.Card.CardView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Green">
        <TextBlock Text="{Binding Name}" FontSize="30" Foreground="White"/>
        <TextBlock Text="{Binding Description}" FontSize="20" Foreground="White"/>
    </StackPanel>
</UserControl>