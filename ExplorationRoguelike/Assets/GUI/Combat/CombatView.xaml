<UserControl x:Class="ExplorationRoguelike.GUI.Combat.CombatView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"> 
  <Border Background="DodgerBlue" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="50,20">
    <StackPanel>
      <TextBlock Text="{Binding PlayerHealth}" FontSize="30" Foreground="White"/>
            <Button Content="Button" Command="{Binding EnemyAttackedCommand}" Margin="0,10,0,0"/>
    </StackPanel>
  </Border>
</UserControl>
