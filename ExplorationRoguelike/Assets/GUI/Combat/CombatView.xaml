<UserControl x:Class="ExplorationRoguelike.GUI.Combat.CombatView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="DodgerBlue" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="50,20">
        <StackPanel>
            <TextBlock Text="{Binding PlayerHealth}" FontSize="30" Foreground="White"/>
            <TextBlock Text="{Binding EnemyHealth}" FontSize="30" Foreground="White"/>
            <TextBlock Text="{Binding CombatState}" FontSize="30" Foreground="White"/>
            <Button Content="Player Attack" Command="{Binding PlayerTurnTakenCommand}" CommandParameter="{Binding SelectedPlayerCard}" Margin="0,10,0,0"/>
            <Button Content="Enemy Attack" Command="{Binding EnemyTurnTakenCommand}" CommandParameter="{Binding SelectedEnemyCard}" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
