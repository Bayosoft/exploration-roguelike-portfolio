<UserControl x:Class="ExplorationRoguelike.GUI.Combat.CombatView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="DodgerBlue" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="50,20">
        <StackPanel>
            <TextBlock FontSize="30" Foreground="White">
                <Run Text="Player HP:"/>
                <Run Text="{Binding PlayerHealth}"/>
            </TextBlock>
            <TextBlock FontSize="30" Foreground="White">
                <Run Text="Mana:"/>
                <Run Text="{Binding PlayerMana}"/>
            </TextBlock>
            <TextBlock FontSize="30" Foreground="White">
                <Run Text="{Binding EnemyName}"/>
                <Run Text="HP:"/>
                <Run Text="{Binding EnemyHealth}"/>
            </TextBlock>
            <TextBlock FontSize="30" Foreground="White">
                <Run Text="Intent:"/>
                <Run Text="{Binding EnemyIntent}"/>
            </TextBlock>
            <TextBlock Text="{Binding CombatState}" FontSize="30" Foreground="White"/>
           <!-- <Button Content="Player Attack" Command="{Binding PlayerTakeTurnCommand}" CommandParameter="{Binding SelectedPlayerAbility}" Margin="0,10,0,0"/> -->
            <Button Content="End Turn" Command="{Binding EndTurnCommand}" Margin="0,10,0,0"/>
            <!--  <Button Content="Enemy Attack" Command="{Binding EnemyTakeTurnCommand}" CommandParameter="{Binding SelectedEnemyAbility}" Margin="0,10,0,0"/> -->
            <TextBlock Text="{Binding Message}" FontSize="30" Foreground="White"/>
            <ListBox ItemsSource="{Binding CardViews}" SelectedItem="{Binding SelectedCard, Mode=OneWayToSource}">
                <ListBox.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding TryPlayCardCommand}" />
                </ListBox.InputBindings>
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>